# Local diagnostics can contain account data, signed URLs and screenshots.
# Keep these files locally; never commit them.
outputs/
.tooling/
*.log
*.apk
*.aab

# Machine configuration and signing credentials
.env
.env.*
!.env.example
config/*.local.json
**/local.properties
**/key.properties
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key

# This is an application: the root pubspec.lock MUST be versioned.
# The generated SDK is a library and resolves through the application's lock.
api/pubspec.lock
